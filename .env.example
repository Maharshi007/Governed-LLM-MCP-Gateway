# Copy to .env and fill in. Providers without a key are skipped automatically.
JWT_SECRET=change-me
ADMIN_API_KEY=dev-admin-key

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Locally hosted model (no key). Install Ollama, then: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Order = priority. "mock" is an offline provider for demos (disable in prod).
PROVIDER_CHAIN=openai,anthropic,ollama,mock
ENABLE_MOCK_PROVIDER=true

# Leave empty for local dev without Docker (fakeredis + SQLite).
# docker-compose overrides these to point at the redis/postgres containers.
# Supabase: postgresql+asyncpg://postgres.<ref>:<password>@<pooler-host>:5432/postgres?ssl=require
#   (use the session pooler on port 5432; the 6543 transaction pooler breaks asyncpg prepared statements)
REDIS_URL=
DATABASE_URL=sqlite+aiosqlite:///./structurai.db

RATE_LIMIT_PER_MINUTE=60
DEFAULT_TOKEN_BUDGET=1000000
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RESET_SECONDS=30
